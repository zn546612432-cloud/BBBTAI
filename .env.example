# Optional for local Node development only. NEVER commit .env.local.
# On GitHub Pages, the protected Supabase Edge Function reads the provider
# Secrets; a player never needs to type them into the public iPhone page.
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=5173
# Do not set DEV_HOST=0.0.0.0 with real keys on an untrusted network.
