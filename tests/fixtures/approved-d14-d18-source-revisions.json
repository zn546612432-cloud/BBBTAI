{
  "d14:meeting": {
    "at": "16:05",
    "lines": [
      {
        "who": "胡枫",
        "text": "/apps/wechat/story/d14/wang-jie-film.webp",
        "kind": "image"
      },
      {
        "who": "胡枫",
        "text": "/apps/wechat/story/d14/business-dinner.webp",
        "kind": "image"
      },
      {
        "who": "胡枫",
        "text": "汪傑這幾年的資料基本都在這裡了。"
      },
      {
        "who": "me",
        "text": "他去年接受採訪的視頻找到了嗎？"
      },
      {
        "who": "胡枫",
        "text": "找到了，原版有二十多分鐘。"
      },
      {
        "who": "阿威",
        "text": "就是他炫耀自己有五億美金的那段？"
      },
      {
        "who": "胡枫",
        "text": "對。"
      },
      {
        "who": "me",
        "text": "發我看看。"
      },
      {
        "who": "胡枫",
        "text": "汪傑_專訪.mp4",
        "kind": "file"
      },
      {
        "who": "仔仔",
        "text": "這個人好喜歡炫耀自己的錢。"
      },
      {
        "who": "小辛",
        "text": "我要是有五億美金，我比他還能炫耀"
      },
      {
        "who": "阿威",
        "text": "他平時到底是做什麼生意的？"
      },
      {
        "who": "胡枫",
        "text": "地產、投資，這兩年才開始做數字貨幣。"
      },
      {
        "who": "me",
        "text": "視頻裡提到的那幾家公司也幫我整理一下。"
      },
      {
        "who": "胡枫",
        "text": "已經列出來了，有一家之前沒查到什麼資料。"
      },
      {
        "who": "me",
        "text": "哪家？"
      },
      {
        "who": "胡枫",
        "text": "名字還沒確認，我再查一下。"
      },
      {
        "who": "熙旺",
        "text": "目前的預算算出來了嗎？"
      },
      {
        "who": "me",
        "text": "差不多兩百萬。"
      },
      {
        "who": "阿威",
        "text": "港幣？"
      },
      {
        "who": "me",
        "text": "嗯。"
      },
      {
        "who": "仔仔",
        "text": "服裝的費用我還沒算進去。"
      },
      {
        "who": "me",
        "text": "你算好了發給我。"
      },
      {
        "who": "熙旺",
        "text": "晚上八點到大屋，大家把各自的預算帶過來。"
      },
      {
        "who": "仔仔",
        "text": "好，我把樣板也帶過去。"
      },
      {
        "who": "小辛",
        "text": "收到"
      }
    ]
  },
  "d15:costumes": {
    "at": "10:22",
    "lines": [
      {
        "who": "仔仔",
        "text": "服裝設計稿_V1.pdf",
        "kind": "file"
      },
      {
        "who": "仔仔",
        "text": "第一版做出來了，你們看看。"
      },
      {
        "who": "阿威",
        "text": "這是我的？"
      },
      {
        "who": "仔仔",
        "text": "對，按照你上次給我的尺寸做的。"
      },
      {
        "who": "阿威",
        "text": "肩膀可能要再改一下。"
      },
      {
        "who": "仔仔",
        "text": "你又胖了？"
      },
      {
        "who": "阿威",
        "text": "那叫肌肉。"
      },
      {
        "who": "小辛",
        "text": "我的呢？"
      },
      {
        "who": "仔仔",
        "text": "還沒做好，你明天過來試。"
      },
      {
        "who": "胡枫",
        "text": "永利那幾張照片你看過了嗎？"
      },
      {
        "who": "仔仔",
        "text": "看了。"
      },
      {
        "who": "仔仔",
        "text": "我另外存了一些今年的品牌服裝照片，原先的設計有點過時。"
      },
      {
        "who": "小辛",
        "text": "所以我們這次可以穿得很帥？"
      },
      {
        "who": "仔仔",
        "text": "你先別對我的設計指手畫腳。"
      },
      {
        "who": "me",
        "text": "我的衣服不用做吧？"
      },
      {
        "who": "仔仔",
        "text": "順便給你做了一套。"
      },
      {
        "who": "me",
        "text": "什麼樣的？"
      },
      {
        "who": "仔仔",
        "text": "等做好你就知道了。"
      },
      {
        "who": "熙旺",
        "text": "明天都過去試一下，有不合適的地方早點改。"
      }
    ]
  },
  "d16:hardware": {
    "at": "14:19",
    "lines": [
      {
        "who": "熙旺",
        "text": "上次你說要更新機房，打算怎麼弄？"
      },
      {
        "who": "me",
        "text": "看中幾個配置，還在比。"
      },
      {
        "who": "熙旺",
        "text": "你別光挑最貴的。"
      },
      {
        "who": "me",
        "text": "貴有貴的道理。"
      },
      {
        "who": "熙旺",
        "text": "那也別跟上次一樣買了四個鍵盤丟在家裡"
      },
      {
        "who": "me",
        "text": "這你不懂，鍵盤是黑客的飯碗，很講究手感的，這幾個手感都不一樣"
      },
      {
        "who": "熙旺",
        "text": "是是是。"
      },
      {
        "who": "me",
        "text": "你上次打遊戲用的那個還是我的。"
      },
      {
        "who": "熙旺",
        "text": "那個確實挺好用的。"
      },
      {
        "who": "me",
        "text": "送你了。"
      },
      {
        "who": "熙旺",
        "text": "這麼大方？"
      },
      {
        "who": "me",
        "text": "因為我要買新的了。"
      },
      {
        "who": "熙旺",
        "text": "……"
      }
    ]
  },
  "d17:rain": {
    "at": "16:18",
    "lines": [
      {
        "who": "仔仔",
        "text": "外面突然好大雨，差點淋成狗"
      },
      {
        "who": "熙旺",
        "text": "看了天氣預報，估計是不會停了，先休息一天吧"
      },
      {
        "who": "阿威",
        "text": "不早說，我已經到附近了。"
      },
      {
        "who": "熙旺",
        "text": "進來，我們好久沒燒烤了，今天聚一下"
      },
      {
        "who": "小辛",
        "text": "我鞋全濕了！！！命苦啊！！剛買的巴黎世家！"
      },
      {
        "who": "胡枫",
        "text": "你訓練為什麼要穿巴黎世家"
      },
      {
        "who": "小辛",
        "text": "別管"
      },
      {
        "who": "阿威",
        "text": "那你順路買點喝的。"
      },
      {
        "who": "小辛",
        "text": "喝什麼？"
      },
      {
        "who": "仔仔",
        "text": "可樂，要無糖的。"
      },
      {
        "who": "胡枫",
        "text": "啤酒。"
      },
      {
        "who": "小辛",
        "text": "蒙哥呢"
      },
      {
        "who": "me",
        "text": "冰可樂。"
      },
      {
        "who": "熙旺",
        "text": "給他買常溫的。"
      },
      {
        "who": "me",
        "text": "……"
      },
      {
        "who": "小辛",
        "text": "收到🫡"
      }
    ]
  },
  "d17:laundry": {
    "at": "18:47",
    "lines": [
      {
        "who": "熙旺",
        "text": "下雨了，幫你把衣服收了"
      },
      {
        "who": "me",
        "text": "親親親親"
      },
      {
        "who": "熙旺",
        "text": "下次自己收"
      },
      {
        "who": "me",
        "text": "嗯嗯嗯嗯！下雨了你們還訓練嗎？"
      },
      {
        "who": "熙旺",
        "text": "你下樓吧，等一下BBQ，今天不練了"
      },
      {
        "who": "me",
        "text": "耶！不過你能不能先給我拿瓶水，我在馬桶上無能為力"
      },
      {
        "who": "熙旺",
        "text": "你不能出來自己拿？"
      },
      {
        "who": "me",
        "text": "我腿麻了"
      },
      {
        "who": "熙旺",
        "text": "我看你屁股也癢了"
      },
      {
        "who": "熙旺",
        "text": "等著"
      }
    ]
  },
  "d18:shoulder": {
    "at": "23:19",
    "lines": [
      {
        "who": "熙旺",
        "text": "今天早上都沒見到你"
      },
      {
        "who": "me",
        "text": "我不是在弄程序嘛。"
      },
      {
        "who": "熙旺",
        "text": "辛苦了。肩膀還疼不疼？"
      },
      {
        "who": "me",
        "text": "一點點吧"
      },
      {
        "who": "熙旺",
        "text": "少趴桌上。"
      },
      {
        "who": "me",
        "text": "那你上來給我按一下。"
      },
      {
        "who": "熙旺",
        "text": "你先去洗澡，我拿點精油"
      },
      {
        "who": "me",
        "text": "耶！"
      },
      {
        "who": "me",
        "text": "今晚和我睡好不好"
      },
      {
        "who": "熙旺",
        "text": "多大的人了還和哥哥睡"
      },
      {
        "who": "me",
        "text": "三歲"
      },
      {
        "who": "熙旺",
        "text": "我等一下還要去乾爹那裡，他年紀大了，需要照顧"
      },
      {
        "who": "me",
        "text": "我服了，他看起來哪裡需要被照顧了"
      },
      {
        "who": "熙旺",
        "text": "乾爹照顧我們那麼多年了，我們照顧他也是應該的，他是爸爸"
      },
      {
        "who": "me",
        "text": "知道了，一個人睡我不會傷心的"
      }
    ]
  }
}
