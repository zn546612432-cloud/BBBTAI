{
  "16:briefing": [
    {
      "who": "胡枫",
      "text": "我把之前踩點的撤離路線整理好了，還有幾個地方沒敲定。大家什麼時候有空一起看一下？"
    },
    {
      "who": "熙旺",
      "text": "那就晚上七點半，大屋。我去接乾爹。"
    },
    {
      "who": "阿威",
      "text": "好。"
    },
    {
      "who": "小辛",
      "text": "很強。"
    }
  ],
  "16:hardware": [
    {
      "who": "熙旺",
      "text": "上次你說要更新機房，打算怎麼弄？"
    },
    {
      "who": "me",
      "text": "看中幾個配置，還在比。"
    },
    {
      "who": "熙旺",
      "text": "你別光挑最貴的。"
    },
    {
      "who": "me",
      "text": "反正有人買單"
    },
    {
      "who": "熙旺",
      "text": "那也別跟上次一樣買了四個鍵盤丟在家裡"
    },
    {
      "who": "me",
      "text": "這你不懂，鍵盤是黑客的飯碗，很講究手感的，這幾個手感都不一樣"
    },
    {
      "who": "熙旺",
      "text": "說不過你。你高興就好。"
    }
  ],
  "17:rain": [
    {
      "who": "仔仔",
      "text": "外面突然好大雨，差點淋成狗"
    },
    {
      "who": "熙旺",
      "text": "看了天氣預報，估計是不會停了，先休息一天吧"
    },
    {
      "who": "阿威",
      "text": "不早說，我已經到附近了。"
    },
    {
      "who": "熙旺",
      "text": "進來，我們好久沒燒烤了，今天聚一下"
    },
    {
      "who": "小辛",
      "text": "我鞋全濕了！！！命苦啊！！剛買的巴黎世家！"
    },
    {
      "who": "胡枫",
      "text": "你訓練為什麼要穿巴黎世家"
    },
    {
      "who": "小辛",
      "text": "別管"
    }
  ],
  "17:laundry": [
    {
      "who": "熙旺",
      "text": "下雨了，幫你把衣服收了"
    },
    {
      "who": "me",
      "text": "親親親親"
    },
    {
      "who": "熙旺",
      "text": "下次自己收"
    },
    {
      "who": "me",
      "text": "嗯嗯嗯嗯！下雨了你們還訓練嗎？"
    },
    {
      "who": "熙旺",
      "text": "你下樓吧，等一下BBQ，今天不練了"
    },
    {
      "who": "me",
      "text": "耶！不過你能不能先給我拿瓶水，我在馬桶上無能為力"
    },
    {
      "who": "熙旺",
      "text": "你不能出來自己拿？"
    },
    {
      "who": "me",
      "text": "我腿麻了"
    },
    {
      "who": "熙旺",
      "text": "我看你你屁股也癢了"
    },
    {
      "who": "熙旺",
      "text": "等著"
    }
  ],
  "18:shoulder": [
    {
      "who": "熙旺",
      "text": "今天早上都沒見到你"
    },
    {
      "who": "me",
      "text": "我不是在弄程序嘛。"
    },
    {
      "who": "熙旺",
      "text": "辛苦了。肩膀還疼不疼？"
    },
    {
      "who": "me",
      "text": "一點點吧"
    },
    {
      "who": "熙旺",
      "text": "少趴桌上。"
    },
    {
      "who": "me",
      "text": "那你上來給我按一下。"
    },
    {
      "who": "熙旺",
      "text": "你先去洗澡，我拿點精油"
    },
    {
      "who": "me",
      "text": "耶！"
    },
    {
      "who": "me",
      "text": "今晚和我睡好不好"
    },
    {
      "who": "熙旺",
      "text": "多大的人了還和哥哥睡"
    },
    {
      "who": "me",
      "text": "三歲"
    },
    {
      "who": "熙旺",
      "text": "我等一下還要去乾爹那裡，他年紀大了，需要照顧"
    },
    {
      "who": "me",
      "text": "我服了，他看起來那裡需要被照顧了"
    },
    {
      "who": "熙旺",
      "text": "乾爹照顧我們那麼多年了，我們照顧他也是應該的，他是爸爸"
    },
    {
      "who": "me",
      "text": "知道了，一個人睡我不會傷心的"
    }
  ],
  "20:awake": [
    {
      "who": "小辛",
      "text": "我才剛醒⋯"
    }
  ]
}
